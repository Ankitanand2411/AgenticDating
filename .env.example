# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Models (override if an id is unavailable on your account) ───────────────
READER_MODEL=claude-sonnet-5-5
DATE_MODEL=claude-haiku-4-5-20251001

# ── Scraping ────────────────────────────────────────────────────────────────
# Apify is the primary scraper for both sources. Free tier gives $5/month,
# enough for ~50 profiles. Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper
APIFY_LINKEDIN_ACTOR=dev_fusion~linkedin-profile-scraper
APIFY_LINKEDIN_INPUT_KEY=profileUrls
# When every scraper fails, the reader agent researches the two profile pages
# with Anthropic's web-search tool, restricted to linkedin.com / instagram.com.
ENABLE_WEB_RESEARCH_FALLBACK=1

# ── Dating harness ──────────────────────────────────────────────────────────
# Rounds per agent per date (3 rounds = 6 messages). 2 is faster, 4 is richer.
DATE_ROUNDS=3
# How many dates / analyses run in parallel.
MAX_CONCURRENCY=6

# ── Storage ─────────────────────────────────────────────────────────────────
# Leave empty to use the JSON file at data/db.json (great for a VPS / local).
# Set a Postgres URL (Supabase, Neon, Railway) for serverless hosts like Vercel.
DATABASE_URL=

# ── Misc ────────────────────────────────────────────────────────────────────
# Hard cap on people so a public site can't be abused into a huge LLM bill.
MAX_PEOPLE=60
# If set, destructive endpoints (delete / reset) require ?token=...
ADMIN_TOKEN=
# Set to 1 to run the whole pipeline with canned LLM + scraper output (no keys needed).
MOCK_MODE=0
